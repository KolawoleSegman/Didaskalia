# Needed for accounts, the leaderboard and the admin dashboard.
# Find both in Supabase > Project Settings > API (use the "anon public" key, never the service_role key).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional: the public web address of the game (used in shared challenge links from the Android app).
# VITE_SITE_URL=https://your-site.example
